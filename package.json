{
  "name": "islambol-yayinlari",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "İslambol Yayınları tanıtım ve katalog sitesi (Eleventy 3, saf CSS, page-flip)",
  "scripts": {
    "cms": "node scripts/cms/server.mjs",
    "test:cms": "node --test tests/cms/*.test.mjs",
    "dev": "eleventy --serve",
    "build": "eleventy",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "gorsel": "node scripts/gorsel/optimize.mjs",
    "test:e2e": "playwright test",
    "serve": "node scripts/qa/sunucu.mjs --dir dist --port 8090",
    "dogrula:seo": "node scripts/seo/dogrula.mjs",
    "dogrula:icerik": "python -I -X utf8 scripts/qa/dogrula.py",
    "test:worker": "node --test worker/tests/*.test.mjs",
    "worker:build": "node worker/scripts/build.mjs",
    "worker:deploy": "node worker/scripts/deploy.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "ajv": "^8.17.1",
    "markdown-it": "^15.0.2",
    "page-flip": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "axe-core": "^4.14.0",
    "esbuild-wasm": "^0.28.2",
    "sharp": "^0.35.5"
  }
}
