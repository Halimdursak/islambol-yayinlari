---
layout: layouts/base.njk
pagination:
  data: books
  size: 1
  alias: kitap
  addAllPagesToCollections: true
permalink: /kitap/{{ kitap.id }}/
ekstra_css:
  - /assets/css/katalog.css
---
{%- set onizleme_kitaplar = [kitap] -%}
{%- from "components/kitap/kapak.njk" import kapak -%}
{%- from "components/kitap/bicim.njk" import yazarlar -%}
{%- from "components/bolum-basligi.njk" import bolumBasligi -%}
{%- set m = site.mikrometin -%}
{%- set iz_ogeler = [{ ad: "Ana sayfa", url: "/" }, { ad: "Kitaplar", url: "/kitaplar/" }, { ad: kitap.title, url: kitap.url }] -%}
{%- set kunye_kategoriler = kitap_kategorileri -%}
{%- set kunye_diziler = kitap_dizileri -%}
{%- set na_kaynaklar = kitap.sources -%}
{%- set na_wa = kitap.whatsapp_url -%}
{#- Eser adı uzunluğuna göre ölçek: kısa ad en büyük başlık, çok uzun ad bir kademe küçük (satır sayısı dengede kalır). -#}
{%- set baslik_uzunluk = kitap.title | length -%}
{%- set baslik_olcek = "kitap-detay__baslik--uzun" if baslik_uzunluk > 56 else ("kitap-detay__baslik--orta" if baslik_uzunluk > 32 else "") -%}
<article class="kitap-detay">
  {#- 1. blok (beyaz): kapak sahnesi + eser bilgisi. Sonraki bloklar bant / beyaz dönüşümlü (CSS: :nth-child(even)). -#}
  <div class="kitap-detay__ust">
    <div class="kap">
      {% include "components/kitap/iz.njk" %}

      <div class="kitap-detay__izgara">
        <div class="kitap-detay__sol">
          <figure class="kitap-detay__kapak"{% if kitap.onizleme %} data-onizleme="{{ kitap.id }}"{% endif %}>
            <span class="kitap-detay__kapak-kap" data-kapak-yuzu="on">
              {{ kapak(kitap, kapaklar[kitap.id], { sizes: "(min-width: 56.25em) 420px, 80vw", yukle: "eager", alt: kitap.title ~ " kapağı" }) }}
            </span>
            {%- if kitap.arka_kapak %}
            <span class="kitap-detay__kapak-kap kitap-detay__kapak-kap--arka" data-kapak-yuzu="arka" hidden>
              <picture>
                {%- if kitap.arka_kapak.webp_url %}<source type="image/webp" srcset="{{ kitap.arka_kapak.webp_url }}">{% endif %}
                <img src="{{ kitap.arka_kapak.url }}"{% if kitap.arka_kapak.genislik and kitap.arka_kapak.yukseklik %} width="{{ kitap.arka_kapak.genislik }}" height="{{ kitap.arka_kapak.yukseklik }}"{% endif %} alt="{{ kitap.title }} arka kapağı" loading="lazy" decoding="async">
              </picture>
            </span>
            {%- endif %}
          </figure>
          {%- if kitap.arka_kapak %}
          <div class="kapak-secici" role="group" aria-label="{{ m.kapak_yuzu }}" data-kapak-secici hidden>
            <button type="button" class="kapak-secici__dugme" data-yuz="on" aria-pressed="true">{{ m.kapak_on }}</button>
            <button type="button" class="kapak-secici__dugme" data-yuz="arka" aria-pressed="false">{{ m.kapak_arka }}</button>
            <a class="kapak-secici__dugme kapak-secici__buyut" href="{{ kitap.arka_kapak.url }}" target="_blank" rel="noopener" aria-label="{{ m.kapak_buyut_aria }}" data-buyut hidden>{{ m.kapak_buyut }}</a>
          </div>
          <noscript><p class="kitap-detay__not"><a href="{{ kitap.arka_kapak.url }}">{{ m.kapak_arka }}</a></p></noscript>
          {%- endif %}
          <div class="kitap-detay__eylemler">
            <a class="dugme dugme--birincil kitap-detay__hizli-siparis" href="{{ kitap.whatsapp_url }}" rel="noopener noreferrer">{{ m.whatsapp_cta }}</a>
            {%- if kitap.onizleme %}
            <button type="button" class="dugme dugme--ikincil kitap-detay__onizle" data-onizleme="{{ kitap.id }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="18" height="18" aria-hidden="true"><path d="M3 5.5c3-1 6-1 9 1 3-2 6-2 9-1v13c-3-1-6-1-9 1-3-2-6-2-9-1z"/><path d="M12 6.5v13"/></svg>{{ m.onizle_uzun }}
            </button>
            <p class="kitap-detay__not">{{ m.onizleme_notu }}</p>
            {%- endif %}
          </div>
        </div>

        <div class="kitap-detay__sag">
          {%- if kitap_kategorileri.length or kitap.is_set or (kitap.yil and kitap.yil == site.yil) %}
          <ul class="etiketler" aria-label="{{ m.filtre_kategori }}">
            {%- for k in kitap_kategorileri %}
            <li><a class="cip" href="/kitaplar/?kategori={{ k.slug }}">{{ k.ad }}</a></li>
            {%- endfor %}
            {%- if kitap.yil and kitap.yil == site.yil %}<li><span class="cip cip--durum">{{ m.yeni }}</span></li>{% endif %}
            {%- if kitap.is_set %}<li><span class="cip cip--durum">Takım</span></li>{% endif %}
          </ul>
          {%- endif %}

          <h1 class="kitap-detay__baslik {{ baslik_olcek }}">{{ kitap.title }}</h1>
          {%- if kitap.subtitle %}<p class="kitap-detay__alt-baslik">{{ kitap.subtitle }}</p>{% endif %}
          {%- if kitap.authors.length or kitap.yazar_gosterim %}
          <p class="kitap-detay__yazar">{{ yazarlar(kitap, true, "") }}</p>
          {%- endif %}
          {%- if kitap.fiyat_gosterim %}
          <p class="kitap-detay__fiyat" data-fiyat><span class="kitap-detay__fiyat-etiket">{{ m.fiyat_etiket }}</span> <strong class="rakam">{{ kitap.fiyat_gosterim }}</strong><span class="kitap-detay__fiyat-not">{{ m.fiyat_notu }}</span></p>
          {%- endif %}

          {%- if kitap_paragraflar.length %}
          <div class="kitap-detay__metin">
            {#- Giriş paragrafı (büyük punto) yalnız gerçek bir tanıtım cümlesi olduğunda: kısa başlık benzeri satır ya da çok uzun blok büyütülmez. -#}
            {%- for p in kitap_paragraflar %}
            <p{% if loop.first and p.length > 80 and p.length <= 480 %} class="kitap-detay__giris"{% endif %}>{{ p }}</p>
            {%- endfor %}
          </div>
          {%- endif %}

          {%- if kitap.is_set %}
          <section class="kitap-detay__takim" aria-labelledby="takim-baslik">
            <h2 class="etiket" id="takim-baslik">Takım</h2>
            <p>Bu kayıt, birden fazla ciltten oluşan bir takımdır.</p>
            {%- if kitap.set_items and kitap.set_items.length %}
            <ul class="kitap-detay__takim-liste">
              {%- for it in kitap.set_items %}<li>{{ it.title or it.baslik or it.ad or it }}</li>{% endfor %}
            </ul>
            {%- endif %}
          </section>
          {%- endif %}

          {% include "components/kitap/nereden-alinir.njk" %}
        </div>
      </div>
    </div>
  </div>

  {#- 2. blok (bant): künye -#}
  <div class="kitap-detay__bolum">
    <div class="kap">
      {% include "components/kitap/kunye-tablosu.njk" %}
    </div>
  </div>

  {%- if ayni_yazardan.length %}
  <section class="kitap-detay__bolum" aria-labelledby="ayni-yazardan">
    <div class="kap">
      {{ bolumBasligi(etiket=m.kunye_yazar, baslik="Aynı yazardan", id="ayni-yazardan", url=("/yazar/" ~ kitap.yazar_sluglari[0] ~ "/") if kitap.yazar_sluglari.length else "", baglanti=m.tum_kitaplar) }}
      <div class="kartlar">
        {%- for kitap in ayni_yazardan %}
        {% include "components/kitap/kitap-karti.njk" %}
        {%- endfor %}
      </div>
    </div>
  </section>
  {%- endif %}

  {%- if kitap_dizileri.length %}
  <section class="kitap-detay__bolum" aria-labelledby="kitabin-dizisi">
    <div class="kap">
      {{ bolumBasligi(etiket="Set / Seri", baslik="Bu kitabın dizisi", id="kitabin-dizisi") }}
      <div class="dizi-izgara">
        {%- for dizi in kitap_dizileri %}
        {% include "components/kitap/dizi-karti.njk" %}
        {%- endfor %}
      </div>
    </div>
  </section>
  {%- endif %}
</article>
