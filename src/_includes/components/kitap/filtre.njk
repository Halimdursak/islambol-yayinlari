{#
  Katalog süzgeç çubuğu — B2. Girdi (sayfa verisi): filtreKategoriler, filtreYazarlar, filtreYillar, katalog.
  Form baştan görünür: eskiden `hidden` gelip filtre.js ile açılıyordu ve liste ~370 px aşağı sıçrıyordu (CLS 0,36, ADR-017).
  JS yokken denetimler işe yaramaz; base.njk <noscript> stili formu gizler ve tüm liste görünür (ilerlemeli iyileştirme).
#}
{%- set m = site.mikrometin -%}
<form class="filtre" data-filtre role="search" aria-label="{{ m.filtre_baslik }}"
  data-sonuc-sablon="{{ m.filtre_sonuc }}">
  <div class="filtre__kategoriler cipler" role="group" aria-label="{{ m.filtre_kategori }}">
    <button type="button" class="cip" data-kategori-cip="" aria-pressed="true">{{ m.filtre_hepsi }}<span class="cip__sayi">{{ katalog.length }}</span></button>
    {%- for k in filtreKategoriler %}
    <button type="button" class="cip" data-kategori-cip="{{ k.slug }}" aria-pressed="false">{{ k.ad }}<span class="cip__sayi">{{ k.sayi }}</span></button>
    {%- endfor %}
  </div>
  <div class="filtre__alanlar">
    <label class="filtre__alan">
      <span class="etiket">{{ m.filtre_yazar }}</span>
      <select name="yazar" data-alan="yazar">
        <option value="">{{ m.filtre_hepsi }}</option>
        {%- for y in filtreYazarlar %}
        <option value="{{ y.slug }}">{{ y.ad }} ({{ y.sayi }})</option>
        {%- endfor %}
      </select>
    </label>
    <label class="filtre__alan">
      <span class="etiket">{{ m.filtre_yil }}</span>
      <select name="yil" data-alan="yil">
        <option value="">{{ m.filtre_hepsi }}</option>
        {%- for y in filtreYillar %}
        <option value="{{ y.yil }}">{{ y.yil }} ({{ y.sayi }})</option>
        {%- endfor %}
      </select>
    </label>
    <label class="filtre__alan filtre__ara">
      <span class="etiket">Ara</span>
      <input type="search" name="q" data-alan="q" placeholder="{{ m.filtre_ara }}" aria-label="{{ m.filtre_ara }}" autocomplete="off">
    </label>
    <button type="button" class="cip filtre__onizleme" data-onizlemeli-cip aria-pressed="false">Önizlemeli</button>
  </div>
  <div class="filtre__durum">
    <p class="filtre__sonuc" data-sonuc role="status" aria-live="polite">{{ m.filtre_sonuc | replace("{n}", katalog.length) }}</p>
    <button type="button" class="dugme dugme--ucuncul" data-temizle hidden>{{ m.filtre_temizle }}</button>
  </div>
</form>
