<header class="ust">
  <div class="kap ust__ic">
    <a class="ust__logo" href="/">
      <img src="/logo/islambol-logo.png" width="800" height="800" alt="{{ site.ad }}" decoding="async">
    </a>
    <form class="ust__arama" action="/kitaplar/" method="get" role="search" aria-label="Kitap kataloğunda ara">
      <label class="sr-only" for="ust-arama">Kitap veya yazar ara</label>
      <input id="ust-arama" type="search" name="q" placeholder="Bir kitap, bir yazar, yeni bir keşif…" autocomplete="off">
      <button type="submit" aria-label="Katalogda ara"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg></button>
    </form>
    <a class="ust__satis" href="/nereden-alinir/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z"/><circle cx="12" cy="10" r="2.3"/></svg><span>Satış noktaları</span></a>
    <button class="ust__menu-dugme dugme dugme--ikincil dugme--kucuk" type="button" aria-expanded="false" aria-controls="ana-menu"
      data-ac="{{ site.mikrometin.menu_ac }}" data-kapat="{{ site.mikrometin.menu_kapat }}">{{ site.mikrometin.menu_ac }}</button>
  </div>
  <nav class="ust__nav" id="ana-menu" aria-label="Ana menü">
    <div class="kap ust__nav-ic">
      <ul class="ust__liste">
        {%- for m in site.menu %}
        <li><a href="{{ m.url }}"{% if page.url == m.url %} aria-current="page"{% endif %}>{{ m.etiket }}</a></li>
        {%- endfor %}
      </ul>
      <a class="ust__yeni" href="/#b-yeni">Yeni çıkanlar <span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>
