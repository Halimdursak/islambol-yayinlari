{#
  Alt bilgi — B1. Veri: site.slogan, footer_menu, telefon_gosterim, eposta, adres, sosyal, satis_kanallari, mikrometin.footer_telif/footer_not.
  Kuruluş yılı vb. doğrulanmamış bilgi yazılmaz (DESIGN §4.2).
#}
<footer class="alt">
  <div class="kap">
    <div class="alt__ust">
      <div class="alt__marka">
        <a class="ust__logo alt__logo" href="/"><img src="/logo/islambol-logo.png" width="800" height="800" alt="{{ site.ad }}" loading="lazy" decoding="async"></a>
        <p class="alt__slogan">{{ site.slogan }}</p>
      </div>
      <nav class="alt__kolon" aria-labelledby="alt-yayinevi">
        <h2 class="alt__baslik etiket" id="alt-yayinevi">Yayınevi</h2>
        <ul class="alt__liste">
          {%- for m in site.footer_menu %}
          <li><a href="{{ m.url }}">{{ m.etiket }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      <div class="alt__kolon">
        <h2 class="alt__baslik etiket" id="alt-iletisim">İletişim</h2>
        <ul class="alt__liste" aria-labelledby="alt-iletisim">
          <li><a class="rakam" href="tel:{{ site.telefon | replace(' ', '') }}">{{ site.telefon_gosterim }}</a></li>
          <li><a href="{{ site.whatsapp_url }}" rel="noopener noreferrer">{{ site.mikrometin.whatsapp_cta }}</a></li>
          <li><a href="mailto:{{ site.eposta }}">{{ site.eposta }}</a></li>
          <li><span class="alt__adres">{{ site.adres }}</span></li>
          {%- for ad, url in site.sosyal %}
          <li><a href="{{ url }}" rel="noopener noreferrer">{{ ad | capitalize }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      <div class="alt__kolon">
        <h2 class="alt__baslik etiket" id="alt-kanallar">{{ site.mikrometin.nereden_alinir }}</h2>
        <ul class="alt__liste" aria-labelledby="alt-kanallar">
          {%- for k in site.satis_kanallari %}{% if k.url %}
          <li><a href="{{ k.url }}" rel="noopener noreferrer">{{ k.ad }}</a></li>
          {%- endif %}{% endfor %}
        </ul>
      </div>
    </div>
    <div class="alt__dip">
      <p class="alt__telif">{{ site.mikrometin.footer_telif | replace("{yil}", site.yil | string) }}</p>
      <p class="alt__not">{{ site.mikrometin.footer_not }}</p>
      <a class="alt__yonetim" href="/yonetim/">Yönetici paneli</a>
    </div>
  </div>
</footer>
