---js
{
  layout: "layouts/base.njk",
  ekstra_css: ["/assets/css/vitrin.css"],
  onizleme_kaynak: "vitrin",
  eleventyComputed: {
    title: (d) => d.site.meta.sayfalar["/"].title,
    description: (d) => d.site.meta.sayfalar["/"].description,
  },
}
---
{#
  Ana sayfa — Beyaz Vitrin. Sıra: duyuru slaytı → keşif kısayolları → yeni çıkanlar (raf) → önizlemeli kitaplar (bant, raf)
  → yazarlar (raf) → kategoriler (bant) → yayın hikâyesi + sayılar → nereden alınır (bant).
  Önizleme: sayfada <template> basılan kitaplar `vitrin.onizlemeli`dir (base.njk → kitap-onizleme.njk). `onizlemeli_idler` içindeki bir
  kitabın kartındaki "Önizle" rozeti ve hero kapağı [data-onizleme] tetikleyicisidir (flipbook.js); listede olmayan kitap kitap sayfasına gider.
#}
{% from "components/dugme.njk" import dugme %}
{% from "components/kitap/kapak.njk" import kapak %}
{% set mt = site.mikrometin %}
{% set hero = vitrin.one_cikan %}
{% set cizgi_html = sayfalar['yayin-cizgisi'].html %}
{% set cizgi_ozet = sayfalar['yayin-cizgisi'].ozet %}
{% set onizlemeli_idler = [] %}
{% for k in vitrin.onizlemeli %}{% set _ = onizlemeli_idler.push(k.id) %}{% endfor %}

{# Slayt sahnesi: ana kapak (perspektifli) ve iki arka kapak. multiply, dönen sarmalayıcının KENDİSİNDE durur. #}
{% macro kitapSahnesi(kitap, n) %}
{#- Arka kapaklar slayttan slayta değişir: ana kitap dışındaki yeni çıkanlardan, slayt numarasına göre ikili seçilir. -#}
{%- set aday = [] -%}
{%- for k in vitrin.yeni_cikanlar -%}{%- if k.id != kitap.id -%}{%- set _a = aday.push(k) -%}{%- endif -%}{%- endfor -%}
<div class="vitrin__kitaplar">
  {% if aday.length %}{% set sol = aday[(2 * n - 2) % aday.length] %}
  <span class="vitrin__kitap vitrin__kitap--arka-sol" aria-hidden="true">{{ kapak(sol, kapaklar[sol.id], { sizes: "(min-width: 64rem) 160px, 110px", yukle: "lazy", alt: "" }) }}</span>
  {% endif %}
  {% if aday.length > 1 %}{% set sag = aday[(2 * n - 1) % aday.length] %}
  <span class="vitrin__kitap vitrin__kitap--arka-sag" aria-hidden="true">{{ kapak(sag, kapaklar[sag.id], { sizes: "(min-width: 64rem) 160px, 110px", yukle: "lazy", alt: "" }) }}</span>
  {% endif %}
  <a class="vitrin__kitap vitrin__kitap--ana" href="{{ kitap.url }}"{% if kitap.id in onizlemeli_idler %} data-onizleme="{{ kitap.id }}"{% endif %} aria-label="{{ kitap.title }}{% if kitap.id in onizlemeli_idler %}: {{ mt.onizle_uzun | lower }}{% else %} kitabını incele{% endif %}">
    {{ kapak(kitap, kapaklar[kitap.id], { sizes: "(min-width: 64rem) 250px, 170px", yukle: "eager" if n == 1 else "lazy", alt: kitap.title }) }}
  </a>
  <p class="vitrin__kitap-kunye"><span>{{ kitap.yazar_gosterim }}</span><cite>{{ kitap.title }}</cite></p>
</div>
{% endmacro %}

<div class="kap vitrin-kap">
  <h1 class="sr-only">{{ site.ad }} — {{ site.slogan }}</h1>
  <section class="vitrin" aria-label="Yeni kitaplar ve yayınevi duyuruları" aria-roledescription="slayt gösterisi" data-carousel>
    <div class="vitrin__slaytlar" data-slides>
      {% if campaigns and campaigns.length %}
      {% for campaign in campaigns %}
      {% set kampanya_kitabi = campaign.book or hero %}
      <div class="vitrin__slayt vitrin__slayt--{{ campaign.theme or 'cream' }}{% if campaign.image_url %} vitrin__slayt--gorselli{% endif %}" data-slide id="duyuru-{{ loop.index }}" role="group" aria-roledescription="slayt" aria-label="{{ loop.index }} / {{ campaigns.length }}"{% if not loop.first %} hidden{% endif %}>
        <div class="vitrin__metin">
          <p class="vitrin__etiket">{{ campaign.eyebrow or "Yeni bir okuma" }}</p>
          <h2 class="vitrin__baslik">{{ campaign.title }}</h2>
          {% if campaign.description %}<p class="vitrin__aciklama">{{ campaign.description }}</p>{% endif %}
          <div class="vitrin__eylemler">
            <a class="dugme dugme--birincil" href="{{ campaign.url }}">{{ campaign.button_label or "Kitabı incele" }}</a>
            {% if kampanya_kitabi and kampanya_kitabi.id in onizlemeli_idler and not campaign.image_url %}
            <button type="button" class="dugme dugme--ikincil" data-onizleme="{{ kampanya_kitabi.id }}">{{ mt.onizle_uzun }}</button>
            {% endif %}
          </div>
        </div>
        <div class="vitrin__gorsel">
          {% if campaign.image_url %}
          <a class="vitrin__reklam" href="{{ campaign.url }}" aria-label="{{ campaign.title }}"><img src="{{ campaign.image_url }}" width="900" height="720" alt="{{ campaign.title }}" loading="{{ 'eager' if loop.first else 'lazy' }}"{% if loop.first %} fetchpriority="high"{% endif %} decoding="async"></a>
          {% elif kampanya_kitabi %}
          {{ kitapSahnesi(kampanya_kitabi, loop.index) }}
          {% endif %}
        </div>
      </div>
      {% endfor %}
      {% else %}
      <div class="vitrin__slayt vitrin__slayt--cream" data-slide id="duyuru-1" role="group" aria-roledescription="slayt">
        <div class="vitrin__metin">
          <p class="vitrin__etiket">İslambol Yayınları</p>
          <h2 class="vitrin__baslik">Bir kitap açın.<br><em>Yeni bir bakış kazanın.</em></h2>
          <p class="vitrin__aciklama">Tarihin izini süren eserler, düşünceye açılan sayfalar. İslambol'un kitaplarıyla tanışın.</p>
          <div class="vitrin__eylemler"><a class="dugme dugme--birincil" href="/kitaplar/">Kitapları keşfet</a></div>
        </div>
        <div class="vitrin__gorsel">{% if hero %}{{ kitapSahnesi(hero, 1) }}{% endif %}</div>
      </div>
      {% endif %}
    </div>
    {% if campaigns and campaigns.length > 1 %}
    <div class="vitrin__kontroller" data-carousel-controls hidden>
      <button class="yuvarlak-dugme" type="button" data-slide-prev aria-label="Önceki duyuru"><span aria-hidden="true">←</span></button>
      <div class="vitrin__noktalar" role="group" aria-label="Duyuru seç">
        {% for campaign in campaigns %}<button class="vitrin__nokta" type="button" data-slide-to="{{ loop.index0 }}" aria-controls="duyuru-{{ loop.index }}" aria-label="{{ loop.index }}. duyuru: {{ campaign.title | replace('\n', ' ') }}"{% if loop.first %} aria-current="true"{% endif %}><span class="sr-only">{{ loop.index }}</span></button>{% endfor %}
      </div>
      <button class="yuvarlak-dugme" type="button" data-slide-next aria-label="Sonraki duyuru"><span aria-hidden="true">→</span></button>
    </div>
    <p class="sr-only" aria-live="polite" aria-atomic="true" data-slide-status></p>
    {% endif %}
  </section>
</div>

<nav class="kap kesif-kisayollari" aria-label="Kitap keşif bağlantıları">
  <a href="/kitaplar/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M3 5c3-1 6-1 9 1 3-2 6-2 9-1v14c-3-1-6-1-9 1-3-2-6-2-9-1z"/><path d="M12 6v14"/></svg><span>Bir sonraki kitabınızı bulun</span></a>
  <a href="/kitaplar/?onizleme=1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 12h7M9 16h5"/></svg><span>Satın almadan önce okuyun</span></a>
  <a href="/nereden-alinir/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z"/><circle cx="12" cy="10" r="2.3"/></svg><span>Kitaplara nereden ulaşırım?</span></a>
</nav>

<section class="bolum bolum--raf" aria-labelledby="b-yeni" data-scroll-shelf>
  <div class="kap">
    <header class="raf-basligi"><div><p class="raf-basligi__etiket">Kütüphanenize yeni bir sayfa</p><h2 id="b-yeni">Yeni çıkanlar</h2></div><div class="raf-basligi__eylemler"><a href="/kitaplar/">Tüm kitaplar</a><div class="raf-oklari" data-scroll-controls hidden><button class="yuvarlak-dugme" type="button" data-scroll-prev aria-label="Önceki yeni çıkanlar" aria-controls="yeni-seridi">←</button><button class="yuvarlak-dugme" type="button" data-scroll-next aria-label="Sonraki yeni çıkanlar" aria-controls="yeni-seridi">→</button></div></div></header>
  </div>
  <div class="serit" id="yeni-seridi" data-scroll-track role="region" aria-label="Yeni çıkan kitaplar" tabindex="0">
    {% for k in vitrin.yeni_cikanlar %}<div class="serit__oge">{% set kitap = k %}{% set onizleme_tetik = (k.id in onizlemeli_idler) %}{% include "components/kitap/kitap-karti.njk" %}</div>{% endfor %}
  </div>
</section>

{% if vitrin.onizlemeli.length %}
<section class="bolum bolum--raf bant" aria-labelledby="b-onizleme" data-scroll-shelf>
  <div class="kap">
    <header class="raf-basligi"><div><p class="raf-basligi__etiket">İlk sayfalar sizi bekliyor</p><h2 id="b-onizleme">Sayfalarına göz atın</h2></div><div class="raf-basligi__eylemler"><a href="/kitaplar/?onizleme=1">Önizlemeli kitaplar</a><div class="raf-oklari" data-scroll-controls hidden><button class="yuvarlak-dugme" type="button" data-scroll-prev aria-label="Önceki önizlemeli kitaplar" aria-controls="onizleme-seridi">←</button><button class="yuvarlak-dugme" type="button" data-scroll-next aria-label="Sonraki önizlemeli kitaplar" aria-controls="onizleme-seridi">→</button></div></div></header>
  </div>
  <div class="serit" id="onizleme-seridi" data-scroll-track role="region" aria-label="Önizlemeli kitaplar" tabindex="0">
    {% for k in vitrin.onizlemeli %}<div class="serit__oge">{% set kitap = k %}{% set onizleme_tetik = true %}{% include "components/kitap/kitap-karti.njk" %}</div>{% endfor %}
  </div>
</section>
{% endif %}

<section class="bolum bolum--raf" aria-labelledby="b-yazarlar" data-scroll-shelf>
  <div class="kap">
    <header class="raf-basligi"><div><p class="raf-basligi__etiket">Kitapların ardındaki isimler</p><h2 id="b-yazarlar">Yazarlarımız</h2></div><div class="raf-basligi__eylemler"><a href="/yazarlar/">Tüm yazarlar</a><div class="raf-oklari" data-scroll-controls hidden><button class="yuvarlak-dugme" type="button" data-scroll-prev aria-label="Önceki yazarlar" aria-controls="yazar-seridi">←</button><button class="yuvarlak-dugme" type="button" data-scroll-next aria-label="Sonraki yazarlar" aria-controls="yazar-seridi">→</button></div></div></header>
  </div>
  <div class="serit serit--yazar" id="yazar-seridi" data-scroll-track role="region" aria-label="Yazar listesi" tabindex="0">
    {% for y in vitrin.yazarlar %}<div class="serit__oge">{% set yazar = y %}{% include "components/kitap/yazar-karti.njk" %}</div>{% endfor %}
  </div>
</section>

<section class="bolum bant kategori-vitrini" aria-labelledby="b-kategoriler">
  <div class="kap">
    <header class="raf-basligi"><div><p class="raf-basligi__etiket">Merakınızın izinden</p><h2 id="b-kategoriler">Hangi raftan başlayalım?</h2></div><a href="/kitaplar/">Kataloğu keşfet</a></header>
    <div class="kategori-kartlari">
      {% for kategori in site.sozluk.kategoriler %}{% if loop.index <= 4 %}
      {%- set kat_kitaplar = [] -%}
      {%- for b in books -%}{%- if kat_kitaplar.length < 3 and (kategori.slug in b.site_kategori_sluglari) and not (b.id in vitrin.haric) and b.kapak_url -%}{%- set _k = kat_kitaplar.push(b) -%}{%- endif -%}{%- endfor %}
      <a class="kategori-karti" href="/kitaplar/?kategori={{ kategori.slug }}">
        {%- if kat_kitaplar.length %}<span class="kategori-karti__kapaklar" aria-hidden="true">{% for b in kat_kitaplar %}<span>{{ kapak(b, kapaklar[b.id], { sizes: "80px", yukle: "lazy", alt: "" }) }}</span>{% endfor %}</span>{% endif %}
        <span class="kategori-karti__ad">{{ kategori.ad }}</span><span class="kategori-karti__ok" aria-hidden="true">↗</span>
      </a>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="bolum yayin-hikayesi" aria-labelledby="b-cizgi">
  <div class="kap">
    <div class="yayin-hikayesi__ic">
      <p class="raf-basligi__etiket">İslambol Yayınları</p>
      <h2 id="b-cizgi">{{ site.slogan }}</h2>
      <p class="yayin-hikayesi__ozet">{{ cizgi_ozet or (cizgi_html.split('</p>')[0] | striptags | truncate(280)) }}</p>
      <a class="dugme dugme--ucuncul" href="/yayin-cizgisi/">Yayın çizgimizi keşfedin</a>
    </div>
    <dl class="sayilar" aria-label="Katalog özeti">
      <div class="sayi"><dt>Kitap</dt><dd class="rakam">{{ books.length }}</dd></div>
      <div class="sayi"><dt>Yazar</dt><dd class="rakam">{{ authors.length }}</dd></div>
      <div class="sayi"><dt>Önizlemeli kitap</dt><dd class="rakam">{{ books | selectattr("onizleme") | length }}</dd></div>
      <div class="sayi"><dt>Set ve seri</dt><dd class="rakam">{{ diziler.length }}</dd></div>
    </dl>
  </div>
</section>

<section class="bolum bolum--son bant satis-vitrini" aria-labelledby="b-alinir">
  <div class="kap">
    <header class="raf-basligi"><div><p class="raf-basligi__etiket">Kitapla buluşun</p><h2 id="b-alinir">İslambol kitapları burada.</h2></div></header>
    <div class="satis-vitrini__ic">
      <div class="satis-vitrini__cta">
        <p class="satis-vitrini__etiket">Telefon ve WhatsApp</p>
        <h3 class="satis-vitrini__no rakam"><a href="tel:{{ site.telefon | replace(' ', '') }}">{{ site.telefon_gosterim }}</a></h3>
        {{ dugme(mt.whatsapp_cta, site.whatsapp_url, "birincil", true) }}
      </div>
      <div>
        <ul class="satis-vitrini__kanallar">
          {% for kanal in site.satis_kanallari %}{% if kanal.url %}
          <li><a href="{{ kanal.url }}" rel="noopener noreferrer"><span>{{ kanal.ad }}{% if kanal.not %}<small>{{ kanal.not }}</small>{% endif %}</span><span class="satis-vitrini__ok" aria-hidden="true">↗</span></a></li>
          {% endif %}{% endfor %}
        </ul>
        <p class="satis-vitrini__not">{{ mt.nereden_alinir_not }}</p>
      </div>
    </div>
  </div>
</section>
