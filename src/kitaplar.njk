---
layout: layouts/base.njk
permalink: /kitaplar/
ekstra_css:
  - /assets/css/katalog.css
---
{%- set m = site.mikrometin -%}
{%- set iz_ogeler = [{ ad: "Ana sayfa", url: "/" }, { ad: "Kitaplar", url: "/kitaplar/" }] -%}
<div class="kap katalog">
  {% include "components/kitap/iz.njk" %}
  <header class="katalog__ust">
    <span class="etiket">{{ m.kayit }}</span>
    <h1 class="katalog__baslik">Kitaplar</h1>
    <p class="katalog__sayi">{{ m.kayit_sayisi | replace("{n}", katalog.length) }}</p>
  </header>

  {% include "components/kitap/filtre.njk" %}

  <div class="kartlar" id="kitap-listesi" data-liste>
    {%- for kitap in katalog %}
    {% set kart_baslik = "h2" %}{% include "components/kitap/kitap-karti.njk" %}
    {%- endfor %}
  </div>

  <div class="bos-durum" data-bos hidden>
    <h2 class="bos-durum__baslik">{{ m.bos_durum_baslik }}</h2>
    <p>{{ m.bos_durum_kitaplar }}</p>
    <button type="button" class="dugme dugme--ikincil" data-temizle>{{ m.filtre_temizle }}</button>
  </div>
</div>
<script type="module" src="/assets/js/filtre.js"></script>
