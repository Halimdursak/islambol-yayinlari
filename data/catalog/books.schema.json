{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://islambolyayinlari.example/books.schema.json",
  "title": "İslambol Yayınları kitap kataloğu",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "authors",
      "author_display",
      "cover",
      "sources"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "subtitle": {
        "type": [
          "string",
          "null"
        ]
      },
      "alt_titles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "edition": {
        "type": [
          "string",
          "null"
        ]
      },
      "authors": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "author_display": {
        "type": [
          "string",
          "null"
        ]
      },
      "isbn": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9Xx-]{10,17}$"
      },
      "pages": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      },
      "publish_date": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
      },
      "dimensions": {
        "type": [
          "string",
          "null"
        ]
      },
      "binding": {
        "type": [
          "string",
          "null"
        ]
      },
      "paper": {
        "type": [
          "string",
          "null"
        ]
      },
      "language": {
        "type": [
          "string",
          "null"
        ]
      },
      "categories": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": {
        "type": [
          "string",
          "null"
        ]
      },
      "price_list_try": {
        "type": [
          "number",
          "null"
        ]
      },
      "is_set": {
        "type": "boolean"
      },
      "set_items": {
        "type": "array"
      },
      "series": {
        "type": [
          "string",
          "null"
        ]
      },
      "cover": {
        "type": "object",
        "properties": {
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https?://"
          },
          "local_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "width": {
            "type": [
              "integer",
              "null"
            ]
          },
          "height": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "sources": {
        "type": "object",
        "properties": {
          "kitapyurdu": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "nobelkitap": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "kureselkitap": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "other": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                }
              }
            }
          }
        }
      }
    },
    "additionalProperties": true
  }
}
